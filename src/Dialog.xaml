<Window x:Class="BatteryOne.Dialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BatteryOne" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <StackPanel>
        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1">
            <StackPanel Margin="24,20,24,24">
                <TextBlock x:Name="HeadingText" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="20"
                           FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="MessageText" Margin="0,12,0,0" TextWrapping="Wrap" />
                <CheckBox x:Name="DontAskAgainBox" Style="{StaticResource CheckBoxStyle}" Margin="0,20,0,0"
                          Content="Don't show this again" Visibility="Collapsed" />
            </StackPanel>
        </Border>
        <Grid Margin="24,24,24,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="PrimaryButton" Style="{StaticResource AccentButton}" IsDefault="True" Click="Primary_Click" />
            <Button Grid.Column="2" Style="{StaticResource StandardButton}" Content="Cancel" IsCancel="True" />
        </Grid>
    </StackPanel>
</Window>
