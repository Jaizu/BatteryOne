<Window x:Class="BatteryOne.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BatteryOne" Width="460" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Margin="20,16,20,20">

        <!-- Wheel status -->
        <Border Style="{StaticResource Card}" Padding="20,16">
            <StackPanel>
                <DockPanel>
                    <Button x:Name="RefreshButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                            Click="Refresh_Click" ToolTip="Refresh now" Margin="0,-6,-8,0"
                            AutomationProperties.Name="Refresh now">
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Text="&#xE72C;" />
                    </Button>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StateDot" Width="10" Height="10" Margin="0,1,8,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="StateText" FontWeight="SemiBold" Text="Checking…" />
                    </StackPanel>
                </DockPanel>

                <TextBlock x:Name="PercentText" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="46"
                           FontWeight="SemiBold" Margin="0,6,0,6" Text="–" />

                <Grid Height="8" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="FillColumn" Width="0*" />
                        <ColumnDefinition x:Name="RestColumn" Width="100*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.ColumnSpan="2" CornerRadius="4" Background="{DynamicResource Track}" />
                    <Border x:Name="BarFill" CornerRadius="4" />
                </Grid>

                <TextBlock x:Name="DetailText" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                <TextBlock x:Name="UpdatedText" Style="{StaticResource Secondary}" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- Settings -->
        <TextBlock Text="Settings" FontWeight="SemiBold" Margin="2,20,0,8" />

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <Grid Margin="16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Keep running in the background" />
                        <TextBlock x:Name="BackgroundSubtitle" Style="{StaticResource Secondary}" />
                    </StackPanel>
                    <CheckBox x:Name="BackgroundToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                              Checked="BackgroundToggle_Changed" Unchecked="BackgroundToggle_Changed"
                              AutomationProperties.Name="Keep running in the background" />
                </Grid>

                <Border Style="{StaticResource DividerLine}" />

                <Grid Margin="16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Show icon in the notification area" />
                        <TextBlock Style="{StaticResource Secondary}" Text="Shows the battery level next to the clock. Click it to open this window." />
                    </StackPanel>
                    <CheckBox x:Name="TrayToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                              Checked="TrayToggle_Changed" Unchecked="TrayToggle_Changed"
                              AutomationProperties.Name="Show icon in the notification area" />
                </Grid>

                <Border Style="{StaticResource DividerLine}" />

                <Grid Margin="16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Start with Windows" />
                        <TextBlock Style="{StaticResource Secondary}" Text="Starts in the background when you sign in" />
                    </StackPanel>
                    <CheckBox x:Name="StartupToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                              Checked="StartupToggle_Changed" Unchecked="StartupToggle_Changed"
                              AutomationProperties.Name="Start with Windows" />
                </Grid>

                <Border Style="{StaticResource DividerLine}" />

                <Grid Margin="16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Theme" VerticalAlignment="Center" />
                    <Border Grid.Column="1" BorderThickness="1" BorderBrush="{DynamicResource Divider}" CornerRadius="6" Padding="2">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ThemeSystem" Style="{StaticResource Segment}" Content="System" Checked="Theme_Checked" />
                            <RadioButton x:Name="ThemeLight" Style="{StaticResource Segment}" Content="Light" Checked="Theme_Checked" />
                            <RadioButton x:Name="ThemeDark" Style="{StaticResource Segment}" Content="Dark" Checked="Theme_Checked" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Stream Deck -->
        <TextBlock Text="Stream Deck" FontWeight="SemiBold" Margin="2,20,0,8" />

        <Border Style="{StaticResource Card}">
            <Grid Margin="16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Stream Deck plugin" />
                    <TextBlock x:Name="StreamDeckStatus" Style="{StaticResource Secondary}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="StreamDeckUpdateButton" Style="{StaticResource AccentButton}" Content="Update"
                            Margin="0,0,8,0" Visibility="Collapsed" Click="StreamDeckUpdate_Click" />
                    <Button x:Name="StreamDeckButton" Style="{StaticResource StandardButton}" Click="StreamDeckButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Updates -->
        <TextBlock Text="Updates" FontWeight="SemiBold" Margin="2,20,0,8" />

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <Grid Margin="16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock x:Name="VersionText" Text="BatteryOne" />
                        <TextBlock x:Name="UpdateStatus" Style="{StaticResource Secondary}" />
                    </StackPanel>
                    <Button x:Name="UpdateButton" Grid.Column="1" Style="{StaticResource StandardButton}" VerticalAlignment="Center"
                            Content="Check for updates" Click="Update_Click" />
                </Grid>

                <Border Style="{StaticResource DividerLine}" />

                <Grid Margin="16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Check for updates automatically" />
                        <TextBlock Style="{StaticResource Secondary}" Text="Checks GitHub at startup and once a day. Updates are only installed when you choose." />
                    </StackPanel>
                    <CheckBox x:Name="AutoUpdateToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                              Checked="AutoUpdateToggle_Changed" Unchecked="AutoUpdateToggle_Changed"
                              AutomationProperties.Name="Check for updates automatically" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Exit -->
        <Button x:Name="ExitButton" Style="{StaticResource DangerButton}" HorizontalAlignment="Right" Margin="0,20,0,0"
                Click="Exit_Click" ToolTip="Close BatteryOne completely" AutomationProperties.Name="Exit BatteryOne">
            <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE7E8;" FontSize="13"
                           VerticalAlignment="Center" Margin="0,1,8,0" />
                <TextBlock Text="Exit BatteryOne" />
            </StackPanel>
        </Button>
    </StackPanel>
    </ScrollViewer>
</Window>
